# VEYRA public configuration.
#
# VITE_* values are PUBLIC. Vite inlines them into the web bundle and the
# Capacitor Android assets at build time, so anything here is readable by
# anyone who has the app. There is no backend in this project that could hold
# a secret on your behalf, and VEYRA does not pretend otherwise.
#
# Catalog + media API base URL (ZST Labs MovieBox API).
VITE_MOVIEBOX_API_BASE_URL=https://api.zstlab.cyou

# ZST Labs API key. Sent on every JSON request as the x-api-key header.
# This key is compiled into the web bundle and the Android APK. Use your own
# key, keep the project private, and rotate it if it leaks.
VITE_ZST_API_KEY=replace-with-your-zst-labs-api-key
